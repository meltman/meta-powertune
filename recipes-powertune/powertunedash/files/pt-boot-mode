#!/usr/bin/env python3
"""Switch the validated CompuLab U-Boot boot policy without rebooting."""

import subprocess
import sys
from pathlib import Path


ENV_CONFIG = Path("/etc/fw_env.config")
EXPECTED_CONFIG = ["/dev/mmcblk2boot0", "0x3F0000", "0x4000"]
MODES = {
    "drive": {"bootdelay": "0", "bootlist": "emmc_ul"},
    "diag": {"bootdelay": "2", "bootlist": "usb_ul sd_ul emmc_ul"},
}

# Literal untouched Device 1 factory commands, not generic distro-boot defaults.
POLICY = {
    "bootcmd": "run bsp_bootcmd",
    "bsp_bootcmd": (
        "echo Running BSP bootcmd ...; for src in ${bootlist}; do echo Running "
        "${src} ...; run ${src}; env exist boot_opt && env exists bootargs && "
        "setenv bootargs ${bootargs} ${boot_opt}; if run ulbootscript; then "
        "run ulrunbootscript; fi; if run ulimage; then if run ulfdt; then "
        "booti ${loadaddr} - ${fdt_addr_r}; else if test ${boot_fdt} != yes; "
        "then booti ${loadaddr}; fi; fi; fi; done; "
    ),
    "usb_ul": "usb start; setenv iface usb; setenv dev ${usb_dev}; setenv part ${boot_part};setenv bootargs console=${console} root=${usb_root} ${root_opt};",
    "sd_ul": "setenv iface mmc; setenv dev ${sd_dev}; setenv part ${boot_part};setenv bootargs console=${console} root=${sd_root} ${root_opt};",
    "emmc_ul": "setenv iface mmc; setenv dev ${emmc_dev}; setenv part ${boot_part};setenv bootargs console=${console} root=${emmc_root} ${root_opt};",
    "ulbootscript": "load ${iface} ${dev}:${part} ${scriptaddr} ${bsp_script};",
    "ulrunbootscript": "echo Running bootscript from ${iface} ${dev}:${part} ...; source ${scriptaddr}",
    "ulimage": "echo loading ${image}; load ${iface} ${dev}:${part} ${loadaddr} ${image}",
    "ulfdt": "if test ${boot_fdt} = yes || test ${boot_fdt} = try; then echo loading ${fdtfile}; load ${iface} ${dev}:${part} ${fdt_addr_r} ${fdtfile}; if env exists fdtofile;then run ulfdto; else true; fi; fi;",
    "emmc_dev": "2",
    "sd_dev": "1",
    "usb_dev": "0",
    "boot_part": "1",
    "emmc_root": "/dev/mmcblk2p2",
    "sd_root": "/dev/mmcblk1p2",
    "usb_root": "/dev/sda2",
    "bsp_script": "boot.scr",
}
OPTIONAL_EMPTY = ("preboot", "altbootcmd", "bootlimit")


class BootModeError(Exception):
    pass


def verify_config(path):
    try:
        lines = [line.split("#", 1)[0].split()
                 for line in path.read_text().splitlines()]
    except OSError as exc:
        raise BootModeError(f"cannot read {path}: {exc}") from exc
    entries = [line for line in lines if line]
    if entries != [EXPECTED_CONFIG]:
        raise BootModeError(f"{path} does not match the validated Device 0 environment geometry")


def command(args, context):
    try:
        result = subprocess.run(args, text=True, capture_output=True, check=False)
    except OSError as exc:
        raise BootModeError(f"{context}: {exc}") from exc
    # libubootenv can fall back to defaults after an invalid environment.
    # A warning is not evidence that the persistent values were read safely.
    if result.returncode or result.stderr.strip():
        detail = result.stderr.strip() or f"exit status {result.returncode}"
        raise BootModeError(f"{context}: {detail}")
    return result.stdout


def read_environment(name=None):
    args = ["fw_printenv"] + ([name] if name else [])
    output = command(args, f"fw_printenv {name or 'environment'} failed")
    values = {}
    for line in output.splitlines():
        key, separator, value = line.partition("=")
        if not separator or not key or key in values:
            raise BootModeError(f"fw_printenv {name or 'environment'} returned malformed output")
        values[key] = value
    if name and (set(values) != {name}):
        raise BootModeError(f"fw_printenv {name} did not return exactly that variable")
    return values


def policy_mismatches(values):
    return ([key for key, expected in POLICY.items() if values.get(key) != expected]
            + [key for key in OPTIONAL_EMPTY if values.get(key, "")])


def mode(values):
    if not policy_mismatches(values):
        for label, expected in MODES.items():
            if all(values.get(key) == value for key, value in expected.items()):
                return label.upper()
    return "CUSTOM"


def main(argv=None, config_path=ENV_CONFIG):
    args = sys.argv[1:] if argv is None else argv
    if len(args) != 1 or args[0] not in ("status", "drive", "diag"):
        print("Usage: pt-boot-mode {status|drive|diag}", file=sys.stderr)
        return 2
    try:
        verify_config(config_path)
        original = read_environment()
        if args[0] == "status":
            print(mode(original))
            for name in ("bootdelay", "bootlist", *POLICY, *OPTIONAL_EMPTY):
                print(f"{name}={original[name]}" if name in original else f"{name}=<unset>")
            mismatches = policy_mismatches(original)
            if mismatches:
                print("Unvalidated boot policy: " + ", ".join(mismatches))
            return 0

        mismatches = policy_mismatches(original)
        if mismatches:
            raise BootModeError("refusing to write: unvalidated boot policy variables: "
                                + ", ".join(mismatches))
        target = MODES[args[0]]
        # Retain/reinstate the interactive delay for as long as possible.
        order = ("bootlist", "bootdelay") if args[0] == "drive" else ("bootdelay", "bootlist")
        for name in order:
            if original.get(name) == target[name]:
                continue
            try:
                command(["fw_setenv", name, target[name]], f"fw_setenv {name} failed")
                actual = read_environment(name)[name]
                if actual != target[name]:
                    raise BootModeError(f"verification failed for {name}: expected {target[name]!r}, got {actual!r}")
            except BootModeError as exc:
                raise BootModeError(
                    f"{exc}; original bootdelay={original.get('bootdelay', '<unset>')!r}, "
                    f"bootlist={original.get('bootlist', '<unset>')!r}; "
                    "environment may be partially changed; inspect status before rebooting"
                ) from exc
        try:
            final = read_environment()
        except BootModeError as exc:
            raise BootModeError(
                f"final verification failed: {exc}; "
                f"original bootdelay={original.get('bootdelay', '<unset>')!r}, "
                f"bootlist={original.get('bootlist', '<unset>')!r}; inspect status before rebooting"
            ) from exc
        final_mismatches = policy_mismatches(final)
        final_mismatches += [name for name, value in target.items() if final.get(name) != value]
        if final_mismatches:
            raise BootModeError(
                f"final verification failed for {', '.join(final_mismatches)}; "
                f"original bootdelay={original.get('bootdelay', '<unset>')!r}, "
                f"bootlist={original.get('bootlist', '<unset>')!r}; inspect status before rebooting"
            )
        print(f"{args[0].upper()} (no reboot performed)")
        return 0
    except BootModeError as exc:
        print(f"pt-boot-mode: {exc}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
